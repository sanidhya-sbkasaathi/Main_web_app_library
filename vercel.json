{
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/:match*",
      "destination": "/downloads/:match*"
    },
    {
      "source": "/((?!downloads/).*)",
      "destination": "/index.html"
    }
  ]
}
